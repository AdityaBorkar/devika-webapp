{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": ".",
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext"
	},
	"exclude": ["dist", "node_modules"]
}
