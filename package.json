{
	"dependencies": {
		"@base-ui-components/react": "^1.0.0-beta.0",
		"@electric-sql/pglite": "^0.3.4",
		"@niledatabase/server": "^4.2.0",
		"@t3-oss/env-core": "^0.13.8",
		"arktype": "^2.1.20",
		"better-auth": "^1.2.10",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.44.2",
		"pg": "^8.16.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-icons": "^5.5.0",
		"react-router": "^7.6.2",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.2.10",
		"@biomejs/biome": "^2.0.0-beta.6",
		"@types/bun": "^1.2.17",
		"@types/pg": "^8.15.4",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"bun-plugin-tailwind": "^0.0.15",
		"drizzle-kit": "^0.31.4",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.20.3"
	},
	"name": "@devika/web-app",
	"patchedDependencies": {
		"@electric-sql/pglite@0.3.4": "patches/@electric-sql%2Fpglite@0.3.4.patch"
	},
	"private": true,
	"scripts": {
		"build": "bun build:auth-schema && bun build:server",
		"build:auth-schema": "bunx @better-auth/cli@latest generate --config ./src/lib/auth/config.ts --output ./src/lib/db/schema/auth.generated.ts",
		"build:server": "bun ./#blunt/build.ts",
		"cert:generate": "mkdir -p certs && openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem -out certs/cert.pem -sha256 -days 365 -nodes -subj '/CN=localhost'",
		"check": "bun check:code && bun check:types",
		"check:code": "biome check --write",
		"check:types": "tsc --noEmit",
		"clean": "rm -rf dist certs src/lib/db/schema/auth.generated.ts",
		"commit": "bun scripts/commit.ts",
		"db": "bun --env-file=.env.local drizzle-kit",
		"db:push-schema": "bun scripts/push-schema.ts",
		"dev": "bunx kill-port 3000 && sleep 1 && bun --hot ./#blunt/server.tsx",
		"local-db:reset": "bun local-db:stop && docker rm $(docker ps -aq --filter ancestor=ghcr.io/niledatabase/testingcontainer:latest) 2>/dev/null || true",
		"local-db:start": "docker run -p 3010:5432 -d ghcr.io/niledatabase/testingcontainer:latest",
		"local-db:stop": "docker kill $(docker ps -q --filter ancestor=ghcr.io/niledatabase/testingcontainer:latest) 2>/dev/null || true",
		"start": "NODE_ENV=production bun ./#blunt/server.tsx"
	},
	"type": "module",
	"version": "0.1.0"
}
